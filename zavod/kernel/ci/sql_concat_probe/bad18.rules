// ДОКУМЕНТ: zavod/kernel/ci/sql_concat_probe/bad18.rules — проба 3.3.10.2 (аудит M3310-R16): правило polkit запускает программу.
// ДАТА: 2026-11-02 15:54 +02:00  ИСПОЛНИТЕЛЬ: Claude (сессия fd43469f-418c-4f8b-b94b-32cc0b8d4acf)
polkit.addRule(function (action, subject) { polkit.spawn(["/usr/bin/psql", "-f", "/tmp/query.sql"]); });
