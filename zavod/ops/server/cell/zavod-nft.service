[Unit]
Description=Zavod server filter nftables (protocol I.12v)
DefaultDependencies=no
Before=network-pre.target zagent-start.service zavod-proxy.service
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/zavod/zavod-egress.nft

[Install]
WantedBy=multi-user.target
