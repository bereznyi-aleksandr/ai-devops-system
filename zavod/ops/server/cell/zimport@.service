# ДОКУМЕНТ: zavod/ops/server/cell/zimport@.service
# ВЕРСИЯ: v0.4  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-01 15:33 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-01 21:12 +02:00 (v0.4: аудит M33-R2-04 — только при смонтированном разделе приёма, журнал вне него)
# ИСПОЛНИТЕЛЬ: Claude (сессия 026813c0-b682-4a65-a177-a655b49ea34c)
# НАЗНАЧЕНИЕ: доверенный приём файлов аренды %i (протокол v3.1 И.12д, Л.23; карта 3.3.9.3). Запускается после
#   успешной остановки zquarantine@%i (OnSuccess= там). Без сети и базы; читает out/ и опись, пишет только в
#   accepted/ и свой журнал. После любого итога root переносит in/ и out/ аренды в archive/ (ExecStopPost=+).
# ОГРАНИЧЕНИЯ: ProtectProc оставлен по умолчанию: программа сама проверяет по /proc, что процессов zquarantine нет.
[Unit]
# Аудит M33-R2-04: без раздела приёма (var-lib-zavod-intake.mount) служба не стартует.
RequiresMountsFor=/var/lib/zavod/intake
Description=Zavod trusted import of archive %i (protocol I.12d)
After=zquarantine@%i.service

[Service]
Type=oneshot
User=zimport
Group=zimport
UMask=0027
ExecStart=/usr/bin/python3 -I /usr/local/lib/zavod/zavod_intake.py import %i
ExecStopPost=+/usr/bin/python3 -I /usr/local/lib/zavod/zavod_intake.py archive %i import
RuntimeMaxSec=300
MemoryMax=512M
CPUQuota=100%
TasksMax=8
LimitFSIZE=4G
LimitNOFILE=256
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/run/postgresql -/var/run/postgresql -/run/zavod -/var/lib/zavod/start-archive -/var/lib/zavod/start-rejected -/var/lib/zavod/start-state
ProtectSystem=strict
ReadWritePaths=/var/lib/zavod/intake/accepted /var/lib/zavod/intake-journal/import
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# RestrictSUIDSGID= не включён: systemd тогда отвечает ENOSYS на openat2 (режим файла внутри структуры нельзя проверить),
#   и приём уходит на запасной путь (CI 41313174440, OPENAT2_DIAG). Права файлов приём ставит сам: 0640, 0750 только по описи.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
