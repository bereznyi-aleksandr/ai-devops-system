# ИСПОЛНИТЕЛЬ: Claude (сессия 026813c0-b682-4a65-a177-a655b49ea34c)
# НАЗНАЧЕНИЕ: клетка сессии агента (протокол v3.1 И.12б, карта 3.3.8.3). Имя экземпляра — 32 шестнадцатеричных
#   знака, номер аренды без дефисов. Запускает только zagent-start (root) после lease_reserve_start.
# ОГРАНИЧЕНИЯ: сеть только к посреднику 127.0.0.2:3128 (zavod-proxy) и сокет привратника /run/zavod-gate/agent.sock;
#   запись только в свою папку
#   /var/lib/zagent/<id> (раздел var-lib-private-zagent.mount, 10 ГБ) и во временные /tmp, /var/tmp (в памяти,
#   по 512 МБ, в счёт MemoryMax); пространства имён закрыты — исключение для песочницы Claude Code придёт с пробой ПБ-11.
[Unit]
Description=Zavod agent session %i (cell, protocol I.12b)
After=network.target zavod-nft.service
Requires=zavod-nft.service
RequiresMountsFor=/var/lib/private/zagent

[Service]
Type=exec
Slice=zagent.slice
ExecStart=/usr/local/lib/zavod/zagent-session %i
DynamicUser=yes
StateDirectory=zagent/%i
StateDirectoryMode=0700
WorkingDirectory=%S/zagent/%i
UMask=0077
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/tmp:size=512M,mode=1777 /var/tmp:size=512M,mode=1777
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=127.0.0.2
InaccessiblePaths=-/run/systemd/resolve -/run/dbus -/run/postgresql -/run/zavod -/var/lib/zavod -/etc/zavod
Environment=HTTPS_PROXY=http://127.0.0.2:3128 HTTP_PROXY=http://127.0.0.2:3128 NO_PROXY= ZAVOD_GATE_SOCKET=/run/zavod-gate/agent.sock
MemoryMax=3G
CPUQuota=200%
TasksMax=256
RuntimeMaxSec=14400
Restart=no
