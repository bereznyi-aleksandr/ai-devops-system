# ДОКУМЕНТ: zavod/ops/server/cell/zagent@.service
# ВЕРСИЯ: v0.1  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-01 13:47 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-01 13:47 +02:00
# ИСПОЛНИТЕЛЬ: Claude (сессия 026813c0-b682-4a65-a177-a655b49ea34c)
# НАЗНАЧЕНИЕ: клетка сессии агента (протокол v3.1 И.12б, карта 3.3.8.3). Имя экземпляра — 32 шестнадцатеричных
#   знака, номер аренды без дефисов. Запускает только zagent-start (root) после lease_reserve_start.
# ОГРАНИЧЕНИЯ: сеть только к посреднику ядра (допущение: 127.0.0.2, вопрос аудитору); запись только в свою папку
#   /var/lib/zagent/<id>; пространства имён закрыты — исключение для песочницы Claude Code придёт с пробой ПБ-11.
[Unit]
Description=Zavod agent session %i (cell, protocol I.12b)
After=network.target

[Service]
Type=exec
Slice=zagent.slice
ExecStart=/usr/local/lib/zavod/zagent-session %i
DynamicUser=yes
StateDirectory=zagent/%i
StateDirectoryMode=0700
WorkingDirectory=%S/zagent/%i
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=127.0.0.2
MemoryMax=3G
CPUQuota=200%
TasksMax=256
RuntimeMaxSec=14400
Restart=no
