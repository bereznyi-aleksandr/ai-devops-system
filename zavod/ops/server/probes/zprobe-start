# v0.10 (2026-11-14 12:48 +02:00, аудит ChatGPT REL34 M-01, M-02): --restore-request сначала проверяет всё — /run/zprobe,
#   папку серии и её содержимое — и только потом что-то меняет (группу, новую папку, новый request.json). Отказ на
#   любом шаге проверки ничего не меняет. Содержимое папки перечисляется самим bash (массив по шаблону, имена без
#   потерь), а не разбором текста ls: файл с переводом строки в имени — «посторонний файл», отказ. У готового
#   request.json, которому ставится группа, проверяется ещё число жёстких ссылок: только 1.
# v0.9 (2026-11-14 12:27 +02:00, аудит ChatGPT REL33 M-01): новый вызов zprobe-start --restore-request <серия> — ручное
#   восстановление серии, которая получила отметку начала, но осталась без request.json (сбой после допуска или
#   перезагрузка сервера: /run временный). Только для отметки ровно этой серии и только если других orphan нет и
#   сегмента серии нет (проверка zprobe_journal.py restore-check под общим замком); вызов берётся из отметки.
#   Создаёт недостающее (/run/zprobe, папку серии, request.json — новыми файлами, set -C), старое не меняет, кроме
#   группы своей папки или своего запроса, если сбой был ровно на chgrp. Затем серию закрывает --journal-retry.
#   Проверка «служба работает»: ошибка systemctl — считается «работает» (раньше — «не работает»).
# v0.8 (2026-11-14 12:01 +02:00, аудит ChatGPT REL32 M-01): допуск серии (reserve <серия> <вызов> под общим замком
#   журнала) идёт ПЕРВЫМ; папка /run/zprobe/<серия> и request.json создаются только после него. Отказ BUSY или
#   «имя занято» не оставляет ни папки, ни request: то же имя можно запустить снова (проект CI 9).
# v0.7.1 (2026-11-14 11:17 +02:00): счётчик цикла ожидания без имени (shellcheck SC2034), поведение то же.
# v0.7 (2026-11-14 10:41 +02:00, проект B9 v0.9, приёмка ChatGPT REL31): ставится в /usr/local/lib/zavod/probes-b9; служба
#   прогона zprobe-run-b9@, отметка начала — reserve B9 под общим замком журнала (orphan нет вовсе, иначе BUSY).
#   После прогона ждёт завершения службы журнала zprobe-journal-b9@ (не дольше 300 с) и печатает итог только по
#   подтверждению: целый сегмент серии + строка CONFIRMED запуска, который systemd отметил успешным.
#   Итоги: ZPROBE_START CONFIRMED (код 0) | UNKNOWN | JOURNAL_REFUSED (код 4). Новый вызов:
#   zprobe-start --journal-retry <серия> — один повторный запуск службы журнала, только если прогон и журнал
#   этой серии не работают, заданий в очереди нет и отметка started/<серия> есть.
# v0.6 (2026-11-13 07:08 +02:00, аудит R6B M-R6-01): после отметки начала конец скрипта не зависит от исхода службы:
#   нет SERIES_END или нет папки journal — строка ZPROBE_START series_end=NO, код 0 (исход решает проверка журнала на
#   телефоне); код службы печатается отдельно.
# v0.5 (2026-11-13 05:59 +02:00, аудит R5 M-R5-03): до запуска службы — отметка начала серии командой
#   zprobe_journal.py reserve от zprobe (новый файл /var/lib/zavod/probes/started/<серия>); имя уже отмечено — отказ.
# v0.4 (2026-11-12 23:41 +02:00, аудит R4 M-R4-04): журнал — папка сегментов /var/lib/zavod/probes/journal.
# ДАТА СОЗДАНИЯ: 2026-11-12 19:23 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-12 19:58 +02:00 (v0.3 по аудиту R2 M-03: каталог не меняется, запрос без замены)
# ИСПОЛНИТЕЛЬ: Claude (чат 87eee078-952e-4855-8936-7f4d449aa9ac)
# НАЗНАЧЕНИЕ: начало серии проб по команде телефона оператора (протокол v4 ред12, И.13 п. 2: «серию начинает
#   телефон оператора — даёт перечень проб серии и свежий вызов»). Запускается от root входом администратора:
#   zprobe-start <серия> <вызов 32 hex> ПБ-1. Пишет /run/zprobe/<серия>/request.json и запускает
#   zprobe-run@<серия>.service; печатает итоговую строку серии из журнала.
# ОГРАНИЧЕНИЯ: занятое имя серии — отказ; ничего не удаляет и не переписывает.
set -euo pipefail
die() { echo "ZPROBE_START REFUSED: $*"; exit 2; }
[ "$(id -u)" = 0 ] || die "must run as root"
LIB=/usr/local/lib/zavod/probes-b9
J=/var/lib/zavod/probes/journal
SD=/var/lib/zavod/probes/started
jr() { runuser -u zprobe -- /usr/bin/python3 -I "$LIB/zprobe_journal.py" "$@"; }
busy() {   # 0 — единица работает или её задание в очереди
  local u st
  local jobs
  jobs=$(systemctl list-jobs --no-legend --plain) || return 0          # REL33: нет ответа systemd — «работает»
  for u in "zprobe-run-b9@$1.service" "zprobe-journal-b9@$1.service"; do
    st=$(systemctl show -p ActiveState --value "$u") || return 0
    case "$st" in active|activating|deactivating|reloading) return 0;; esac
    printf '%s\n' "$jobs" | awk '{print $2}' | grep -qxF "$u" && return 0
  done
  return 1
}
dir_state() {   # $1 — папка; DS: absent — нет; ok — root:zprobe 0750; grp — root:root 0750 (сбой на chgrp); иначе отказ.
  # Только проверка, ничего не меняет (REL34 M-02).
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then DS=absent; return 0; fi
  [ ! -L "$1" ] || die "$1 is a symlink"
  case "$(stat -c '%U:%G:%a:%F' "$1")" in
    root:zprobe:750:directory) DS=ok;;
    root:root:750:directory) DS=grp;;
    *) die "$1 exists with unexpected owner or mode";;
  esac
}
finish() {   # $1 — серия, $2 — курсор journalctl до запуска; ждём конец службы журнала и печатаем итог
  local S=$1 CUR=$2 u="zprobe-journal-b9@$1.service" out
  for _ in $(seq 1 300); do
    busy "$S" || break
    sleep 1
  done
  out=$(/usr/bin/python3 -I "$LIB/zprobe_journal.py" outcome "$S" "$CUR")
  echo "ZPROBE_START journal_unit_result=$(systemctl show -p Result --value "$u") journal_segments=$(find "$J" -maxdepth 1 -name '*.jsonl' 2>/dev/null | wc -l)"
  case "$out" in
    "ZPROBE_OUTCOME CONFIRMED "*) echo "ZPROBE_START CONFIRMED series=$S ${out#ZPROBE_OUTCOME CONFIRMED series=$S }"; exit 0;;
    "ZPROBE_OUTCOME JOURNAL_REFUSED "*) echo "ZPROBE_START JOURNAL_REFUSED series=$S SERIES_END JOURNAL_REFUSED ${out#ZPROBE_OUTCOME JOURNAL_REFUSED series=$S }"; exit 4;;
    *) echo "ZPROBE_START UNKNOWN series=$S SERIES_END UNKNOWN ${out#ZPROBE_OUTCOME * series=$S }"; exit 4;;
  esac
}
if [ "${1:-}" = "--journal-retry" ]; then
  [ $# = 2 ] || die "usage: zprobe-start --journal-retry <series>"
  S=$2
  [[ $S =~ ^[0-9A-Za-z_-]{1,40}$ ]] || die "bad series name"
  [ -f "$SD/$S" ] && [ ! -L "$SD/$S" ] || die "no start mark for $S"
  [ -f "/run/zprobe/$S/request.json" ] || die "no request.json for $S"
  busy "$S" && die "units of $S are active or queued"
  CUR=$(journalctl --show-cursor -n 0 -q | sed -n 's/^-- cursor: //p')
  [ -n "$CUR" ] || die "no journalctl cursor"
  set +e +o pipefail
  systemctl start "zprobe-journal-b9@$S.service"
  echo "ZPROBE_START retry_rc=$?"
  finish "$S" "$CUR"
fi
if [ "${1:-}" = "--restore-request" ]; then
  # M-355-REL33-01: серия отмечена, а request.json нет — восстановить его по отметке; новых серий не начинает.
  [ $# = 2 ] || die "usage: zprobe-start --restore-request <series>"
  S=$2
  [[ $S =~ ^[0-9A-Za-z_-]{1,40}$ ]] || die "bad series name"
  [ -f "$SD/$S" ] && [ ! -L "$SD/$S" ] || die "no start mark for $S"
  busy "$S" && die "units of $S are active or queued"
  R=$(jr restore-check "$S") || die "restore-check: ${R:-failed}"
  [[ $R =~ ^ZPROBE_JOURNAL\ RESTORE_OK\ series=([0-9A-Za-z_-]+)\ challenge=([0-9a-f]{32})$ ]] \
    && [ "${BASH_REMATCH[1]}" = "$S" ] || die "restore-check: unexpected answer"
  C=${BASH_REMATCH[2]}
  D=/run/zprobe/$S
  Q=$(printf '{"challenge":"%s","probes":["ПБ-1"],"series":"%s"}' "$C" "$S")
  # REL34 M-01, M-02: сначала проверяется всё, изменений нет; изменения — только после полной проверки
  dir_state /run/zprobe; P0=$DS; P1=absent; RQ=create
  [ "$P0" = absent ] || { dir_state "$D"; P1=$DS; }
  if [ "$P1" != absent ]; then
    shopt -s nullglob dotglob; E=("$D"/*); shopt -u nullglob dotglob   # имена без потерь, без разбора текста
    if [ ${#E[@]} = 0 ]; then RQ=create
    elif [ ${#E[@]} = 1 ] && [ "${E[0]}" = "$D/request.json" ]; then
      # сбой был ровно на chgrp запроса: те же байты, root, 0640, одна жёсткая ссылка — только группа
      [ ! -L "$D/request.json" ] && [ -f "$D/request.json" ] && printf '%s\n' "$Q" | cmp -s - "$D/request.json" \
        || die "request.json of $S exists and differs: use --journal-retry $S or examine it"
      case "$(stat -c '%U:%G:%a:%F:%h' "$D/request.json")" in
        root:zprobe:640:"regular file":1) die "request.json of $S is in place: use --journal-retry $S";;
        root:root:640:"regular file":1) RQ=grp;;
        *) die "request.json of $S has unexpected owner, mode or links";;
      esac
    else die "$D holds other files: examine it"; fi
  fi
  case $P0 in
    absent) mkdir -m 0750 /run/zprobe || die "cannot create /run/zprobe"; chgrp zprobe /run/zprobe || die "cannot chgrp /run/zprobe";;
    grp) chgrp zprobe /run/zprobe || die "cannot chgrp /run/zprobe";;
  esac
  case $P1 in
    absent) mkdir -m 0750 "$D" || die "cannot create $D"; chgrp zprobe "$D" || die "cannot chgrp $D";;
    grp) chgrp zprobe "$D" || die "cannot chgrp $D";;
  esac
  case $RQ in
    create) (umask 0137; set -C; printf '%s\n' "$Q" > "$D/request.json") || die "request.json appeared meanwhile"
            chgrp zprobe "$D/request.json" || die "cannot chgrp $D/request.json";;
    grp) chgrp zprobe "$D/request.json" || die "cannot chgrp $D/request.json";;
  esac
  echo "ZPROBE_START REQUEST_RESTORED series=$S challenge=$C next: zprobe-start --journal-retry $S"
  exit 0
fi
[ $# = 3 ] || die "usage: zprobe-start <series> <challenge> ПБ-1 | zprobe-start --journal-retry <series> | zprobe-start --restore-request <series>"
S=$1; C=$2; P=$3
[[ $S =~ ^[0-9A-Za-z_-]{1,40}$ ]] || die "bad series name"
[[ $C =~ ^[0-9a-f]{32}$ ]] || die "bad challenge"
[ "$P" = "ПБ-1" ] || die "probe list must be exactly ПБ-1"
if [ -d "$J" ] && grep -rqF --include='*.jsonl' "\"series\":\"$S\"" "$J"; then die "series name already in journal"; fi
D=/run/zprobe/$S
[ ! -e "$D" ] || die "series folder already exists"
# R2 M-03: существующий каталог не меняем — только сверяем; новый создаём mkdir (отказ, если имя уже есть).
if [ -e /run/zprobe ]; then
  [ "$(stat -c '%U:%G:%a:%F' /run/zprobe)" = "root:zprobe:750:directory" ] || die "/run/zprobe exists with unexpected owner or mode"
fi
# M-355-REL29-01, M-355-REL32-01: отметка начала — под общим замком журнала и только без orphan вовсе; иначе BUSY.
# Допуск первым: до него ничего не создано, отказ не оставляет ни папки, ни request.json.
R=$(jr reserve "$S" "$C") || die "reserve: ${R:-failed}"
echo "$R"
# Имя теперь отмечено этим вызовом: другой запуск того же имени получает отказ в reserve раньше, чем дойдёт сюда.
LEFT="series $S is reserved, its request may be missing or incomplete; new series are BUSY until: zprobe-start --restore-request $S, then zprobe-start --journal-retry $S"
if [ ! -e /run/zprobe ]; then
  mkdir -m 0750 /run/zprobe || die "cannot create /run/zprobe ($LEFT)"; chgrp zprobe /run/zprobe || die "cannot chgrp /run/zprobe ($LEFT)"
fi
mkdir -m 0750 "$D" || die "cannot create $D ($LEFT)"
chgrp zprobe "$D" || die "cannot chgrp $D ($LEFT)"
# set -C: bash открывает файл с O_EXCL — существующий request.json не может быть заменён.
(umask 0137; set -C; printf '{"challenge":"%s","probes":["ПБ-1"],"series":"%s"}\n' "$C" "$S" > "$D/request.json") \
  || die "request already exists ($LEFT)"
chgrp zprobe "$D/request.json" || die "cannot chgrp $D/request.json ($LEFT)"
CUR=$(journalctl --show-cursor -n 0 -q | sed -n 's/^-- cursor: //p')
[ -n "$CUR" ] || die "no journalctl cursor (series $S reserved; finish it with --journal-retry)"
set +e +o pipefail                     # M-R6-01: с этого места сбой службы — не сбой скрипта; итог решает журнал
systemctl start "zprobe-run-b9@$S.service"
echo "ZPROBE_START unit_rc=$? unit_result=$(systemctl show -p Result --value "zprobe-run-b9@$S.service")"
finish "$S" "$CUR"
