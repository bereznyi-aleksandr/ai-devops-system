#!/bin/bash
# ДОКУМЕНТ: zavod/ops/server/probes/zprobe-start
# ВЕРСИЯ: v0.7 (выпуск B9)  СТАТУС: DRAFT
# v0.7 (2026-11-14 10:41 +02:00, проект B9 v0.9, приёмка ChatGPT REL31): ставится в /usr/local/lib/zavod/probes-b9; служба
#   прогона zprobe-run-b9@, отметка начала — reserve B9 под общим замком журнала (orphan нет вовсе, иначе BUSY).
#   После прогона ждёт завершения службы журнала zprobe-journal-b9@ (не дольше 300 с) и печатает итог только по
#   подтверждению: целый сегмент серии + строка CONFIRMED запуска, который systemd отметил успешным.
#   Итоги: ZPROBE_START CONFIRMED (код 0) | UNKNOWN | JOURNAL_REFUSED (код 4). Новый вызов:
#   zprobe-start --journal-retry <серия> — один повторный запуск службы журнала, только если прогон и журнал
#   этой серии не работают, заданий в очереди нет и отметка started/<серия> есть.
# v0.6 (2026-11-13 07:08 +02:00, аудит R6B M-R6-01): после отметки начала конец скрипта не зависит от исхода службы:
#   нет SERIES_END или нет папки journal — строка ZPROBE_START series_end=NO, код 0 (исход решает проверка журнала на
#   телефоне); код службы печатается отдельно.
# v0.5 (2026-11-13 05:59 +02:00, аудит R5 M-R5-03): до запуска службы — отметка начала серии командой
#   zprobe_journal.py reserve от zprobe (новый файл /var/lib/zavod/probes/started/<серия>); имя уже отмечено — отказ.
# v0.4 (2026-11-12 23:41 +02:00, аудит R4 M-R4-04): журнал — папка сегментов /var/lib/zavod/probes/journal.
# ДАТА СОЗДАНИЯ: 2026-11-12 19:23 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-12 19:58 +02:00 (v0.3 по аудиту R2 M-03: каталог не меняется, запрос без замены)
# ИСПОЛНИТЕЛЬ: Claude (чат 87eee078-952e-4855-8936-7f4d449aa9ac)
# НАЗНАЧЕНИЕ: начало серии проб по команде телефона оператора (протокол v4 ред12, И.13 п. 2: «серию начинает
#   телефон оператора — даёт перечень проб серии и свежий вызов»). Запускается от root входом администратора:
#   zprobe-start <серия> <вызов 32 hex> ПБ-1. Пишет /run/zprobe/<серия>/request.json и запускает
#   zprobe-run@<серия>.service; печатает итоговую строку серии из журнала.
# ОГРАНИЧЕНИЯ: занятое имя серии — отказ; ничего не удаляет и не переписывает.
set -euo pipefail
die() { echo "ZPROBE_START REFUSED: $*"; exit 2; }
[ "$(id -u)" = 0 ] || die "must run as root"
LIB=/usr/local/lib/zavod/probes-b9
J=/var/lib/zavod/probes/journal
SD=/var/lib/zavod/probes/started
jr() { runuser -u zprobe -- /usr/bin/python3 -I "$LIB/zprobe_journal.py" "$@"; }
busy() {   # 0 — единица работает или её задание в очереди
  local u st
  for u in "zprobe-run-b9@$1.service" "zprobe-journal-b9@$1.service"; do
    st=$(systemctl show -p ActiveState --value "$u")
    case "$st" in active|activating|deactivating|reloading) return 0;; esac
    systemctl list-jobs --no-legend --plain | awk '{print $2}' | grep -qxF "$u" && return 0
  done
  return 1
}
finish() {   # $1 — серия, $2 — курсор journalctl до запуска; ждём конец службы журнала и печатаем итог
  local S=$1 CUR=$2 u="zprobe-journal-b9@$1.service" i out
  for i in $(seq 1 300); do
    busy "$S" || break
    sleep 1
  done
  out=$(/usr/bin/python3 -I "$LIB/zprobe_journal.py" outcome "$S" "$CUR")
  echo "ZPROBE_START journal_unit_result=$(systemctl show -p Result --value "$u") journal_segments=$(find "$J" -maxdepth 1 -name '*.jsonl' 2>/dev/null | wc -l)"
  case "$out" in
    "ZPROBE_OUTCOME CONFIRMED "*) echo "ZPROBE_START CONFIRMED series=$S ${out#ZPROBE_OUTCOME CONFIRMED series=$S }"; exit 0;;
    "ZPROBE_OUTCOME JOURNAL_REFUSED "*) echo "ZPROBE_START JOURNAL_REFUSED series=$S SERIES_END JOURNAL_REFUSED ${out#ZPROBE_OUTCOME JOURNAL_REFUSED series=$S }"; exit 4;;
    *) echo "ZPROBE_START UNKNOWN series=$S SERIES_END UNKNOWN ${out#ZPROBE_OUTCOME * series=$S }"; exit 4;;
  esac
}
if [ "${1:-}" = "--journal-retry" ]; then
  [ $# = 2 ] || die "usage: zprobe-start --journal-retry <series>"
  S=$2
  [[ $S =~ ^[0-9A-Za-z_-]{1,40}$ ]] || die "bad series name"
  [ -f "$SD/$S" ] && [ ! -L "$SD/$S" ] || die "no start mark for $S"
  [ -f "/run/zprobe/$S/request.json" ] || die "no request.json for $S"
  busy "$S" && die "units of $S are active or queued"
  CUR=$(journalctl --show-cursor -n 0 -q | sed -n 's/^-- cursor: //p')
  [ -n "$CUR" ] || die "no journalctl cursor"
  set +e +o pipefail
  systemctl start "zprobe-journal-b9@$S.service"
  echo "ZPROBE_START retry_rc=$?"
  finish "$S" "$CUR"
fi
[ $# = 3 ] || die "usage: zprobe-start <series> <challenge> ПБ-1 | zprobe-start --journal-retry <series>"
S=$1; C=$2; P=$3
[[ $S =~ ^[0-9A-Za-z_-]{1,40}$ ]] || die "bad series name"
[[ $C =~ ^[0-9a-f]{32}$ ]] || die "bad challenge"
[ "$P" = "ПБ-1" ] || die "probe list must be exactly ПБ-1"
if [ -d "$J" ] && grep -rqF --include='*.jsonl' "\"series\":\"$S\"" "$J"; then die "series name already in journal"; fi
D=/run/zprobe/$S
[ ! -e "$D" ] || die "series folder already exists"
# R2 M-03: существующий каталог не меняем — только сверяем; новый создаём mkdir (отказ, если имя уже есть).
if [ -e /run/zprobe ]; then
  [ "$(stat -c '%U:%G:%a:%F' /run/zprobe)" = "root:zprobe:750:directory" ] || die "/run/zprobe exists with unexpected owner or mode"
else
  mkdir -m 0750 /run/zprobe || die "cannot create /run/zprobe"; chgrp zprobe /run/zprobe
fi
mkdir -m 0750 "$D" || die "series folder already exists"
chgrp zprobe "$D"
# set -C: bash открывает файл с O_EXCL — существующий request.json не может быть заменён.
(umask 0137; set -C; printf '{"challenge":"%s","probes":["ПБ-1"],"series":"%s"}\n' "$C" "$S" > "$D/request.json") \
  || die "request already exists"
chgrp zprobe "$D/request.json"
# M-355-REL29-01: отметка начала — под общим замком журнала и только без orphan вовсе; иначе BUSY без отметки.
R=$(jr reserve "$S") || die "reserve: ${R:-failed}"
echo "$R"
CUR=$(journalctl --show-cursor -n 0 -q | sed -n 's/^-- cursor: //p')
[ -n "$CUR" ] || die "no journalctl cursor (series $S reserved; finish it with --journal-retry)"
set +e +o pipefail                     # M-R6-01: с этого места сбой службы — не сбой скрипта; итог решает журнал
systemctl start "zprobe-run-b9@$S.service"
echo "ZPROBE_START unit_rc=$? unit_result=$(systemctl show -p Result --value "zprobe-run-b9@$S.service")"
finish "$S" "$CUR"
