# ДОКУМЕНТ: zavod/ops/server/probes/zprobe-run-b14@.service
# ВЕРСИЯ: v0.1 (выпуск B14)  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-18 21:45 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-18 21:45 +02:00
# ИСПОЛНИТЕЛЬ: Claude, терминал zavod (пускатель); выпуск B14 (REL139 AGREED, B14_RELEASE_WORK_ALLOWED=YES)
# v0.1: копия zprobe-run-b13@.service v0.1; отличаются папка программ (/usr/local/lib/zavod/probes-b14), имена служб
#   (*-b14@), Description; TimeoutStartSec 900 → 2700 (= RUN_TIMEOUT бегунка v0.18, L-355-REL139-02), TimeoutStopSec 300 → 600
#   (уборка: остановка до 120 с + ожидание сверки ядра до 30 × 6 с). Службы B9, B10, B13 остаются как есть.
# НАЗНАЧЕНИЕ: служба прогона проб выпуска B14 (бегунок v0.18: отметка RUNNING сразу после старта).
#   Установщик B14 кладёт файл в /etc/systemd/system/zprobe-run-b14@.service.
# ОГРАНИЧЕНИЯ: запускается только через /usr/local/lib/zavod/probes-b14/zprobe-start; таймера нет.
[Unit]
Description=Zavod probe series %i (release B14)
Requires=zavod-proxy.service
After=zavod-proxy.service zavod-nft.service
ConditionPathExists=/run/zprobe/%i/request.json

[Service]
Type=oneshot
User=zprobe
Group=zprobe
ExecStart=+/usr/bin/python3 -I -B /usr/local/lib/zavod/probes-b14/zprobe_runner.py run %i
ExecStopPost=-+/usr/bin/python3 -I -B /usr/local/lib/zavod/probes-b14/zprobe_runner.py cleanup %i
ExecStopPost=+/usr/bin/systemctl start --no-block zprobe-journal-b14@%i.service
TimeoutStartSec=2700
TimeoutStopSec=600
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/zavod/probes
ReadOnlyPaths=/run/zprobe
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
