# ДОКУМЕНТ: zavod/ops/server/probes/zprobe-journal-b13@.service
# ВЕРСИЯ: v0.1 (выпуск B13)  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-18 13:19 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-18 13:19 +02:00
# ИСПОЛНИТЕЛЬ: Claude, терминал zavod (пускатель); проект DESIGN_B13_RELEASE v0.2 п. 2.2, REL125
# v0.1: копия zprobe-journal-b10@.service v0.2; отличаются только папка программ (/usr/local/lib/zavod/probes-b13),
#   имена служб (*-b13@: 1 мест b10 в тексте службы) и Description. Службы B10 и B9 остаются как есть.
# НАЗНАЧЕНИЕ: служба журнала проб выпуска B13 (бегунок v0.15 с решением drop-in zprobe_dropin v0.2). Текст и ограничения —
#   как у службы B10 (см. её паспорт). Установщик B13 кладёт файл в /etc/systemd/system/zprobe-journal-b13@.service.
# ОГРАНИЧЕНИЯ: запускается только через /usr/local/lib/zavod/probes-b13/zprobe-start; таймера нет.
[Unit]
Description=Zavod probe journal %i (release B13)
ConditionPathExists=/run/zprobe/%i/request.json

[Service]
Type=oneshot
User=zprobe
Group=zprobe
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/zavod/probes-b13/zprobe_journal.py commit %i
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/run:ro
BindReadOnlyPaths=/run/zprobe
InaccessiblePaths=-/tmp/.X11-unix
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/zavod/probes
StandardInput=null
