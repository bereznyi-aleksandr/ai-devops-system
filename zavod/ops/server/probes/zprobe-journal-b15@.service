# ДОКУМЕНТ: zavod/ops/server/probes/zprobe-journal-b15@.service
# ВЕРСИЯ: v0.1 (выпуск B15)  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-19 14:08 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-19 14:08 +02:00
# ИСПОЛНИТЕЛЬ: Claude, терминал zavod (пускатель); выпуск B15 (REL155 AGREED, офлайн до ACCEPT выпуска)
# v0.1: копия zprobe-journal-b14@.service v0.1; отличаются только папка программ (/usr/local/lib/zavod/probes-b15),
#   имена служб (*-b15@) и Description. Службы B9, B10, B13, B14 остаются как есть.
# НАЗНАЧЕНИЕ: служба журнала проб выпуска B15. Установщик B15 кладёт файл в /etc/systemd/system/zprobe-journal-b15@.service.
# ОГРАНИЧЕНИЯ: запускается только через /usr/local/lib/zavod/probes-b15/zprobe-start; таймера нет.
[Unit]
Description=Zavod probe journal %i (release B15)
ConditionPathExists=/run/zprobe/%i/request.json

[Service]
Type=oneshot
User=zprobe
Group=zprobe
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/zavod/probes-b15/zprobe_journal.py commit %i
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/run:ro
BindReadOnlyPaths=/run/zprobe
InaccessiblePaths=-/tmp/.X11-unix
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/zavod/probes
StandardInput=null
