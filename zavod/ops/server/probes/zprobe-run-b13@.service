# ДОКУМЕНТ: zavod/ops/server/probes/zprobe-run-b13@.service
# ВЕРСИЯ: v0.1 (выпуск B13)  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-18 13:19 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-18 13:19 +02:00
# ИСПОЛНИТЕЛЬ: Claude, терминал zavod (пускатель); проект DESIGN_B13_RELEASE v0.2 п. 2.2, REL125
# v0.1: копия zprobe-run-b10@.service v0.2; отличаются только папка программ (/usr/local/lib/zavod/probes-b13),
#   имена служб (*-b13@: 3 мест b10 в тексте службы) и Description. Службы B10 и B9 остаются как есть.
# НАЗНАЧЕНИЕ: служба прогона проб выпуска B13 (бегунок v0.15 с решением drop-in zprobe_dropin v0.2). Текст и ограничения —
#   как у службы B10 (см. её паспорт). Установщик B13 кладёт файл в /etc/systemd/system/zprobe-run-b13@.service.
# ОГРАНИЧЕНИЯ: запускается только через /usr/local/lib/zavod/probes-b13/zprobe-start; таймера нет.
[Unit]
Description=Zavod probe series %i (release B13)
Requires=zavod-proxy.service
After=zavod-proxy.service zavod-nft.service
ConditionPathExists=/run/zprobe/%i/request.json

[Service]
Type=oneshot
User=zprobe
Group=zprobe
ExecStart=+/usr/bin/python3 -I -B /usr/local/lib/zavod/probes-b13/zprobe_runner.py run %i
ExecStopPost=-+/usr/bin/python3 -I -B /usr/local/lib/zavod/probes-b13/zprobe_runner.py cleanup %i
ExecStopPost=+/usr/bin/systemctl start --no-block zprobe-journal-b13@%i.service
TimeoutStartSec=900
TimeoutStopSec=300
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/zavod/probes
ReadOnlyPaths=/run/zprobe
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
