# ДОКУМЕНТ: zavod/ops/server/probes/zprobe-run-b10@.service
# ВЕРСИЯ: v0.1 (выпуск B10)  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-11-15 00:18 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-11-15 00:18 +02:00
# ИСПОЛНИТЕЛЬ: Claude, чат «Завод 3.5.5 ПБ-1 · напарник · 04» (869221b9), помощник
# v0.1 (B10, проект B10 v0.18 раздел 7): копия zprobe-run-b9@.service; отличаются только папка программ
#   (/usr/local/lib/zavod/probes-b10), имена служб (*-b10@) и Description. Установщик B10 кладёт этот файл в
#   /etc/systemd/system/zprobe-run-b10@.service; путь и сумма — в LIB/INSTALLED.sha256 (1.3 Б).
# НАЗНАЧЕНИЕ: служба прогона проб выпуска B10 (по тексту службы B9: проект B9 v0.9, приёмка ChatGPT REL31). Рядом с
#   B8 zprobe-run@.service и B9 zprobe-run-b9@.service, их не заменяет. Текст — как у zprobe-run@.service A9 (без PrivateNetwork — дефект D1),
#   кроме трёх строк: программы из /usr/local/lib/zavod/probes-b10; журнал не пишется внутри этой службы —
#   последняя строка ExecStopPost только ставит в очередь отдельную службу журнала zprobe-journal-b10@<серия>
#   (один автоматический запуск, проект B9 раздел 2). Строка с «+» работает от root, ограничения службы её не
#   касаются; --no-block — постановка в очередь без ожидания.
# ОГРАНИЧЕНИЯ: запускается только командой /usr/local/lib/zavod/probes-b10/zprobe-start; таймера нет.
[Unit]
Description=Zavod probe series %i (release B10)
Requires=zavod-proxy.service
After=zavod-proxy.service zavod-nft.service
ConditionPathExists=/run/zprobe/%i/request.json

[Service]
Type=oneshot
User=zprobe
Group=zprobe
ExecStart=+/usr/bin/python3 -I /usr/local/lib/zavod/probes-b10/zprobe_runner.py run %i
ExecStopPost=-+/usr/bin/python3 -I /usr/local/lib/zavod/probes-b10/zprobe_runner.py cleanup %i
ExecStopPost=+/usr/bin/systemctl start --no-block zprobe-journal-b10@%i.service
TimeoutStartSec=900
TimeoutStopSec=300
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/zavod/probes
ReadOnlyPaths=/run/zprobe
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
