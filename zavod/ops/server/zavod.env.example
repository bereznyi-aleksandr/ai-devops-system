# ДОКУМЕНТ: zavod/ops/server/zavod.env.example
# ВЕРСИЯ: v0.1  СТАТУС: DRAFT
# ДАТА СОЗДАНИЯ: 2026-10-31 17:16 +02:00  ДАТА ОБНОВЛЕНИЯ: 2026-10-31 17:16 +02:00 (v0.1: этап 3.3.2.1)
# ИСПОЛНИТЕЛЬ: Claude (сессия 026813c0-b682-4a65-a177-a655b49ea34c)
# НАЗНАЧЕНИЕ: образец единственного файла настроек Завода на сервере: /etc/zavod/zavod.env (протокол v3.1, И.7 п. 4).
#   Его читают службы systemd (EnvironmentFile=) и ручной запуск (node --env-file=/etc/zavod/zavod.env ...).
#   Вид строк — KEY=value без кавычек; допустимые ключи и проверка — zavod/kernel/src/settings.mjs.
# ОГРАНИЧЕНИЯ: секретов здесь нет: ключи служб — только в /etc/zavod/secrets/<служба>/ (И.7 п. 4).

# База: сетевой вход выключен, только сокет с проверкой пользователя Linux (peer), И.7 п. 3.
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=bem
# Выключатель ядра (SR-10): файл со словом RUN или STOP.
KERNEL_STOP_FILE=/var/lib/zavod/kernel.stop
KERNEL_HEALTH_PORT=18954
# Данные Завода (И.7 п. 4).
ZAVOD_RUNTIME_DIR=/var/lib/zavod
# Ограждение процессов исполнителя — cgroup v2 (на Linux вместо Job Object Windows).
ZAVOD_CGROUP_ROOT=/sys/fs/cgroup/zavod
# Пилот P1: программы — из системы, движок Flowable — файл пакета установки.
P1_PYTHON=/usr/bin/python3
P1_JAVA=/usr/bin/java
P1_FLOWABLE_WAR=/opt/zavod/flowable/flowable-rest.war
P1_ENGINE_PORT=8092
